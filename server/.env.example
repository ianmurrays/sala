# Copy to .env and fill in. Never commit .env.

# Required. Bearer token the app sends. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SALA_TOKEN=
# MitID username (login is approved in the MitID app; no password is stored).
AULA_USERNAME=

# Optional. Enables POST /translate.
#ANTHROPIC_API_KEY=
# Optional. Enables push; on ntfy.sh use a long random topic.
#NTFY_TOPIC=
#NTFY_URL=https://ntfy.sh
#NTFY_TOKEN=
#POLL_SECONDS=300
